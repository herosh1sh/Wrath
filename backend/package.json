{
  "name": "wrath-backend",
  "version": "1.0.0",
  "description": "Wrath - Notion-like backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.2.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "socket.io": "4.8.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.3.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}